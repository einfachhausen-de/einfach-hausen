[Unit]
Description=Einfachhausen Laya decision service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/einfach-hausen
EnvironmentFile=/etc/einfach-hausen-laya.env
Environment=TOKENIZERS_PARALLELISM=false
Environment=OMP_NUM_THREADS=2
ExecStart=/home/ubuntu/services/laya-eh/.venv/bin/python -u /srv/einfach-hausen/services/laya/server.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
CPUQuota=200%
MemoryMax=4G
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/.cache/huggingface
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
